# Copy to .env for local runs outside Docker. Compose reads the same names from the
# shell or an .env file next to docker-compose.yml.
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://pulsecheck:pulsecheck@localhost:5433/pulsecheck
REDIS_URL=redis://localhost:6380/0

# Required (32+ chars) when ENVIRONMENT=production.
JWT_SECRET=change-me-to-a-long-random-string-0000
JWT_EXPIRE_MINUTES=60

# DEV ONLY. Allows private/loopback targets. Cloud metadata stays blocked. Rejected in production.
ALLOW_PRIVATE_TARGETS=false

MIN_INTERVAL_SECONDS=10
MAX_CONCURRENT_CHECKS=20
RETENTION_DAYS=30

# SMTP. Dev: Mailpit (docker compose) on localhost:1025, UI on http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
MAIL_FROM=PulseCheck <alerts@pulsecheck.local>
